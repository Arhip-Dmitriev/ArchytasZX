# The qudit Deutsch-Jozsa circuit, proved equal to its output for every d and n,
# and exported to Lean 4.
#
#   |0>  = d^(-1/2) X(0 -> 1)
#   |1>  = d^(-1/2) X(0 -> 1) phase{k: -k/d}
#   F_d  = F^3
#   U_const: X(2 -> 1) adds its input c, wired to the boundary, to the target (scale sqrt(d)).
#   U_bal:   Z(1 -> 2) copies the last data qudit into X(2 -> 1) on the target; n = m + 1.


# Constant oracle: the output is e^(2 pi i c/d) |0>^n (x) F_d|1>, for every input |c>.

@out_const =
    count n
    repeat n: X(0 -> 1)
    t = Z(0 -> 1) phase{k: -k/d}
    e = Z(1 -> 0) phase{k: k/d}
    scalar d^(-(n+1)/2)

load
    count n
    repeat n: X(0 -> 1) -> F^4                          # data qudits
    X(0 -> 1) phase{k: -k/d} -> F^3 -> u = X(2 -> 1)    # target, through U_const
    inputs u.in1
    scalar d^(-n/2)

decide against @out_const
certificate lean deutsch_jozsa_constant.lean


# Balanced oracle: the output is |0>^(n-1) (x) |1> (x) F_d|1>.

@out_bal =
    count m
    repeat m: X(0 -> 1)
    o = X(0 -> 1) phase{k: -k/d}
    t = Z(0 -> 1) phase{k: -k/d}
    scalar d^(-(m+2)/2)

load
    count m
    repeat m: X(0 -> 1) -> F^4                          # first m data qudits
    X(0 -> 1) -> F -> c = Z(1 -> 2) -> F^3              # last data qudit, copied by U_bal
    X(0 -> 1) phase{k: -k/d} -> F^3 -> u = X(2 -> 1)    # target
    c -> u
    scalar d^(-(m+1)/2)

decide against @out_bal
certificate lean deutsch_jozsa_balanced.lean
