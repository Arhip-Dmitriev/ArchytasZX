# The QFT adder (Draper) on n qudits of dimension d implements |x> -> |x + 1 mod d^n>, for
# every n and d: a phase on each Fourier digit, between the QFT and its inverse.
var n, d, x
var Q = d^n

gate QFT = |x>_d -> 1/sqrt(Q) sum(k in 0..Q){ e^(2*pi*i*x*k/Q) |k>_d }
gate IQFT = |x>_d -> 1/sqrt(Q) sum(k in 0..Q){ e^(-2*pi*i*x*k/Q) |k>_d }
gate P = |k> -> e^(2*pi*i*d^j*(floor(k/d^j) % d)/Q) |k>   # phase on digit j

|zeros>_d = |0>_d^@n
|a>_d = 0 |zeros> + |x>
|a> = QFT |a>
for j in 0..n { |a> = P |a> }
show(|a>)
|a> = IQFT |a>
show(|a>)

|want>_d = 0 |zeros> + |(x + 1) % Q>
assert <want|a> == 1
assert <a|a> == 1
