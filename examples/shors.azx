# Shor's algorithm on one state |psi>, with the controlled modular-multiplication loop.
# usage: archytaszx examples/shors.azx A [B] [--seed S] [--ascii | --unicode]
#   N = A*B (B defaults to 1). Integers run numerically with a random base a; names
#   (archytaszx examples/shors.azx x y) run fully symbolically with a symbolic base a.

var N = arg(1) * arg(2, 1)
var m = bitlen(N)
var n = 2*m
var Q = 2^n

func cmul(c, y, k) = ifelse(y < N, (y * k^c) % N, y)
gate CU = |x>|y> -> |x>|cmul(bit(x, j), y, powmod(a, 2^j, N))>
gate IQFT = |x> -> 1/sqrt(Q) sum(k in 0..Q){ e^(-2*pi*i*x*k/Q) |k> }

var a
var p = 0
var how = 0
var tries = 0
|psi> = |0>^@n @ |1 : m>
if known(N) and N % 2 == 0 { var p = 2; var how = 1 }

while tries == 0 or (known(N) and p == 0 and tries < 20) {
  var tries = tries + 1
  if known(N) { var a = rand(2, N - 1) }
  if not known(N) or gcd(a, N) == 1 {
    |psi> = |0>^@n @ |1 : m>
    |psi> = (H^@n @ I) |psi>
    for j in 0..n {
      |psi> = CU |psi>
    }
    |psi> = (IQFT @ I) |psi>
    if not known(N) { print("state before measurement"); show(|psi>) }
    var z = measure|psi>
    var c = floor(z / 2^m)
    var r = denom(c / Q, N)
    if known(N) {
      if r % 2 == 0 and powmod(a, r, N) == 1 {
        var h = powmod(a, r / 2, N)
        var p = gcd(h - 1, N)
        if p == 1 or p == N { var p = gcd(h + 1, N) }
        if p == 1 or p == N { var p = 0 } else { var how = 3 }
      }
    } else {
      var h = powmod(a, r / 2, N)
      var p = gcd(h - 1, N)
      var how = 3
    }
  }
}
assert not known(N) or (p > 1 and p < N)
var q = N / p
if not known(N) {
  assume r % 2 == 0
  assume powmod(a, r, N) == 1
  assume p > 1 and p < N
}

print("result")
show(N, p, q)
print("final state")
show(|psi>)
if how == 3 {
  print("proof")
  show(a, z, c, r, powmod(a, r, N) == 1, r % 2 == 0, h, p > 1 and p < N, p * q == N)
}
if how == 1 { print("proof"); show(N % 2 == 0, p * q == N) }
