# State copy, for every n and every qudit dimension d, proved by induction on n:
# an X state copied by a Z spider into n outputs equals n X states, scaled by d^((1-n)/2).

@copies =
    count n
    repeat n: X(0 -> 1)
    scalar d^((1-n)/2)

load
    count n
    X(0 -> 1) -> z = Z(1 -> 1)
    repeat n: z.out0

prove against @copies
certificate emit induction
certificate kernel
certificate lean copy_induction.lean
