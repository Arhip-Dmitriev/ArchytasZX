# [P2] Lemma A.47 (m = 2, n = 3): the boxes 1_m and 1_n on two wires of dimension mn, the first
# through the multiplier n, into a pink dot (2 -> 1), into a pink dot (1 -> 2), its first output
# through the upward multiplier n and 1_m, its second through 1_n, are the boxes 1_m and 1_n.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.
# A mixed-dimensional Z box is its definition ([P2] (2.3.3)): a Z box over the product of its leg
# dimensions, each leg through a binder or splitter whose other leg carries a pink dot.

@lhs =
    z1 = Z(1 -> 1, literal 6) weight{2: 0, 3: 0, 4: 0, 5: 0}
    z2 = Z(1 -> 1, literal 6) weight{3: 0, 4: 0, 5: 0}
    z3 = Z(1 -> 3, literal 6)
    x4 = X(3 -> 1, literal 6)
    x5 = X(2 -> 1, literal 6)
    x6 = X(1 -> 2, literal 6)
    x7 = X(1 -> 3, literal 6)
    z8 = Z(3 -> 1, literal 6)
    z9 = Z(1 -> 1, literal 6) weight{2: 0, 3: 0, 4: 0, 5: 0}
    z10 = Z(1 -> 1, literal 6) weight{3: 0, 4: 0, 5: 0}
    wire z3.out0 -- x4.in0, z3.out1 -- x4.in1, z3.out2 -- x4.in2, x5.out0 -- x6.in0, z1.out0 -- z3.in0, x4.out0 -- x5.in0, z2.out0 -- x5.in1, x7.out0 -- z8.in0, x7.out1 -- z8.in1, x7.out2 -- z8.in2, x6.out0 -- x7.in0, z8.out0 -- z9.in0, x6.out1 -- z10.in0
    inputs z1.in0, z2.in0
    outputs z9.out0, z10.out0
    scalar 6^(2/2) * 6^(1/2) * 6^(1/2) * 6^(2/2)

@rhs =
    z1 = Z(1 -> 1, literal 6) weight{2: 0, 3: 0, 4: 0, 5: 0}
    z2 = Z(1 -> 1, literal 6) weight{3: 0, 4: 0, 5: 0}
    inputs z1.in0, z2.in0
    outputs z1.out0, z2.out0

load @lhs
prove against @rhs
certificate kernel
