# [P1] Lemma 29, (Hopf) (d = 3): a plain green dot and a pink dot joined by d wires disconnect.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.

@lhs =
    g = Z(1 -> 3, literal 3); p = X(3 -> 1, literal 3); g -> p; g -> p; g -> p
    scalar 3

@rhs =
    e = Z(1 -> 0, literal 3); s = X(0 -> 1, literal 3)
    scalar 3^(-1/2)

load @lhs
prove against @rhs
certificate kernel
