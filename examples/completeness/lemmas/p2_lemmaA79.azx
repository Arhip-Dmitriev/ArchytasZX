# [P2] Lemma A.79 (d = 2, m = 2, two outputs): the pink K_1 state into a W node of dimension d, each
# output into a plain green dot (1 -> m) into the binder, is the pink K_1 state of dimension d^m into
# a W node.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.
# A mixed-dimensional Z box is its definition ([P2] (2.3.3)): a Z box over the product of its leg
# dimensions, each leg through a binder or splitter whose other leg carries a pink dot.

@lhs =
    x1 = X(0 -> 1, literal 2) phase{k: 1*k/2}
    w2 = W(1 -> 2, literal 2)
    z3 = Z(1 -> 2, literal 2)
    b4 = B(literal 2, literal 2)
    z5 = Z(1 -> 2, literal 2)
    b6 = B(literal 2, literal 2)
    wire x1.out0 -- w2.in0, w2.out0 -- z3.in0, z3.out0 -- b4.in0, z3.out1 -- b4.in1, w2.out1 -- z5.in0, z5.out0 -- b6.in0, z5.out1 -- b6.in1
    outputs b4.out0, b6.out0
    scalar 2^(-1/2)

@rhs =
    x1 = X(0 -> 1, literal 4) phase{k: 1*k/4}
    w2 = W(1 -> 2, literal 4)
    wire x1.out0 -- w2.in0
    outputs w2.out0, w2.out1
    scalar 4^(-1/2)

load @lhs
prove against @rhs
certificate kernel
