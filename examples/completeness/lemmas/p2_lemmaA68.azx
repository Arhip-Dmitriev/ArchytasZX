# [P2] Lemma A.68 (m = 2, n = 3): the binder (m, n) and an input of dimension mn into a plain green dot
# (2 -> 1) into the splitter are the splitter on the mn input, its outputs and the m and n inputs
# into plain green dots (2 -> 1).
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.
# A mixed-dimensional Z box is its definition ([P2] (2.3.3)): a Z box over the product of its leg
# dimensions, each leg through a binder or splitter whose other leg carries a pink dot.

@lhs =
    b1 = B(literal 2, literal 3)
    z2 = Z(2 -> 1, literal 6)
    s3 = S(literal 2, literal 3)
    wire b1.out0 -- z2.in1, z2.out0 -- s3.in0
    inputs z2.in0, b1.in0, b1.in1
    outputs s3.out0, s3.out1

@rhs =
    s1 = S(literal 2, literal 3)
    z2 = Z(2 -> 1, literal 2)
    z3 = Z(2 -> 1, literal 3)
    wire s1.out0 -- z2.in0, s1.out1 -- z3.in0
    inputs s1.in0, z2.in1, z3.in1
    outputs z2.out0, z3.out0

load @lhs
prove against @rhs
certificate kernel
