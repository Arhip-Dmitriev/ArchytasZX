# [P2] Lemma A.53 (m = 2, n = 3): the pink K_1 state of dimension mn into the splitter, its n output
# on a plain green effect, is the pink K_1 state of dimension m.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.
# A mixed-dimensional Z box is its definition ([P2] (2.3.3)): a Z box over the product of its leg
# dimensions, each leg through a binder or splitter whose other leg carries a pink dot.

@lhs =
    x1 = X(0 -> 1, literal 6) phase{k: 1*k/6}
    s2 = S(literal 2, literal 3)
    z3 = Z(1 -> 0, literal 3)
    wire x1.out0 -- s2.in0, s2.out1 -- z3.in0
    outputs s2.out0
    scalar 6^(-1/2)

@rhs =
    x1 = X(0 -> 1, literal 2) phase{k: 1*k/2}
    outputs x1.out0
    scalar 2^(-1/2)

load @lhs
prove against @rhs
certificate kernel
