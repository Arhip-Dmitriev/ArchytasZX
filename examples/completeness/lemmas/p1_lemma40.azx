# [P1] Lemma 40 (three green dots, d = 3): a W node and a pink dot each joined to the same three
# plain green dots are two W nodes joined to them.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.

@lhs =
    w = W(1 -> 3, literal 3); p = X(1 -> 3, literal 3)
    g1 = Z(2 -> 1, literal 3); g2 = Z(2 -> 1, literal 3); g3 = Z(2 -> 1, literal 3)
    wire w.out0 -- g1.in0, w.out1 -- g2.in0, w.out2 -- g3.in0, p.out0 -- g1.in1, p.out1 -- g2.in1, p.out2 -- g3.in1
    inputs w.in0, p.in0
    outputs g1.out0, g2.out0, g3.out0
    scalar 3

@rhs =
    w = W(1 -> 3, literal 3); v = W(1 -> 3, literal 3)
    g1 = Z(2 -> 1, literal 3); g2 = Z(2 -> 1, literal 3); g3 = Z(2 -> 1, literal 3)
    wire w.out0 -- g1.in0, w.out1 -- g2.in0, w.out2 -- g3.in0, v.out0 -- g1.in1, v.out1 -- g2.in1, v.out2 -- g3.in1
    inputs w.in0, v.in0
    outputs g1.out0, g2.out0, g3.out0

load @lhs
prove against @rhs
certificate kernel
