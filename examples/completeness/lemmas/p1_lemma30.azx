# [P1] Lemma 30 (k = 1, d = 3): a plain green dot joined upwards by k wires to a pink dot is the
# green dot joined downwards by d - k wires to the pink dot.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.

@lhs =
    g = Z(2 -> 1, literal 3); p = X(1 -> 2, literal 3); wire p.out1 -- g.in1
    inputs g.in0, p.in0
    outputs g.out0, p.out0
    scalar 3^(1/2)

@rhs =
    g = Z(1 -> 3, literal 3); p = X(3 -> 1, literal 3); wire g.out1 -- p.in1, g.out2 -- p.in2
    inputs g.in0, p.in0
    outputs g.out0, p.out0
    scalar 3

load @lhs
prove against @rhs
certificate kernel
