# [P1] Lemma 26, second row (d = 3): a pink cap (0 -> 2) with one leg on a plain green effect is
# the plain green state.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.

@lhs =
    p = X(0 -> 2, literal 3); g = Z(1 -> 0, literal 3); wire p.out0 -- g.in0
    outputs p.out1

@rhs =
    g = Z(0 -> 1, literal 3)

load @lhs
prove against @rhs
certificate kernel
