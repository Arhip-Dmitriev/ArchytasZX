# [P1] Lemma 25 (d = 3): an output leg of a pink dot (1 -> 2) is an input leg through D bent down
# to the output.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.

@lhs =
    p = X(1 -> 2, literal 3)
    inputs p.in0
    outputs p.out0, p.out1
    scalar 3^(1/2)

@rhs =
    p = X(2 -> 1, literal 3); h = F(literal 3); h2 = F(literal 3); c = Z(0 -> 2, literal 3)
    wire c.out0 -- h.in0, h.out0 -- h2.in0, h2.out0 -- p.in1
    inputs p.in0
    outputs c.out1, p.out0
    scalar 3^(1/2)

load @lhs
prove against @rhs
certificate kernel
