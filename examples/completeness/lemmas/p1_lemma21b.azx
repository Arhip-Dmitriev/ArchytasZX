# [P1] Lemma 21 (d = 3): D on both legs of a pink cup (an effect) is the cup.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.

@lhs =
    a = F(literal 3); b = F(literal 3); p = X(2 -> 0, literal 3); a -> F(literal 3) -> p; b -> F(literal 3) -> p

@rhs =
    p = X(2 -> 0, literal 3)

load @lhs
prove against @rhs
certificate kernel
