# [P2] Lemma A.63 (m = 2, n = 3): the plain green dot (2 -> 1) of dimension mn into the splitter is
# a splitter on each input, the m outputs into a plain green dot and the n outputs into another.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.
# A mixed-dimensional Z box is its definition ([P2] (2.3.3)): a Z box over the product of its leg
# dimensions, each leg through a binder or splitter whose other leg carries a pink dot.

@lhs =
    z1 = Z(2 -> 1, literal 6)
    s2 = S(literal 2, literal 3)
    wire z1.out0 -- s2.in0
    inputs z1.in0, z1.in1
    outputs s2.out0, s2.out1

@rhs =
    s1 = S(literal 2, literal 3)
    s2 = S(literal 2, literal 3)
    z3 = Z(2 -> 1, literal 2)
    z4 = Z(2 -> 1, literal 3)
    wire s1.out0 -- z3.in0, s2.out0 -- z3.in1, s1.out1 -- z4.in0, s2.out1 -- z4.in1
    inputs s1.in0, s2.in0
    outputs z3.out0, z4.out0

load @lhs
prove against @rhs
certificate kernel
