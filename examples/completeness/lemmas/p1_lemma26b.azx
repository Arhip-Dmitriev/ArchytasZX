# [P1] Lemma 26 (d = 3): a pink state into a plain green cup (2 -> 0) is the pink effect.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.

@lhs =
    p = X(0 -> 1, literal 3); g = Z(2 -> 0, literal 3); wire p.out0 -- g.in1
    inputs g.in0
    scalar 3^(-1/2)

@rhs =
    p = X(1 -> 0, literal 3)
    scalar 3^(-1/2)

load @lhs
prove against @rhs
certificate kernel
