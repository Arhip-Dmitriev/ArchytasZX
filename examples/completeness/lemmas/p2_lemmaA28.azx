# [P2] Lemma A.28, (Zer) (d = 3): the box 0 state is the pink state.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.

@lhs =
    b = Z(0 -> 1, literal 3) weight{1: 0, 2: 0}

@rhs =
    p = X(0 -> 1, literal 3)
    scalar 3^(-1/2)

load @lhs
prove against @rhs
certificate kernel
