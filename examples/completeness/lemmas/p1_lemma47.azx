# [P1] Lemma 47 (d = 3, a = (a1, a2)): a plain green dot (1 -> 2) with one output through the M box
# and the Z box a is a W node (1 -> 3) into the boxes 1, a1, a2, all into a pink dot, the boxes a1
# and a2 also through the multipliers -1 and -2 into a second pink dot. M is its definition (MB).
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.

@lhs =
    g = Z(1 -> 2, literal 3)
    mb = Z(1 -> 1, literal 3) weight{1: 0, 2: 1}; mw = W(1 -> 3, literal 3)
    u1 = Z(1 -> 2, literal 3); v1 = X(2 -> 1, literal 3); u2 = Z(1 -> 1, literal 3); v2 = X(1 -> 1, literal 3)
    u0 = Z(1 -> 0, literal 3); v0 = X(0 -> 1, literal 3); mp = X(3 -> 1, literal 3)
    a = Z(1 -> 1, literal 3) weight{1: a1, 2: a2}
    wire g.out1 -- mb.in0, mb.out0 -- mw.in0
    wire mw.out0 -- u1.in0, u1.out0 -- v1.in0, u1.out1 -- v1.in1, mw.out1 -- u2.in0, u2.out0 -- v2.in0, mw.out2 -- u0.in0
    wire v1.out0 -- mp.in0, v2.out0 -- mp.in1, v0.out0 -- mp.in2, mp.out0 -- a.in0
    inputs g.in0
    outputs g.out0, a.out0
    scalar 3^(1/2) * 3^(-1/2) * 3

@rhs =
    w = W(1 -> 3, literal 3); o = Z(1 -> 1, literal 3) weight{1: 0, 2: 1}
    c1 = Z(1 -> 2, literal 3) weight{1: 0, 2: a1}; c2 = Z(1 -> 2, literal 3) weight{1: 0, 2: a2}
    p = X(3 -> 1, literal 3)
    m1 = Z(1 -> 2, literal 3); q1 = X(2 -> 1, literal 3); m2 = Z(1 -> 1, literal 3); q2 = X(1 -> 1, literal 3)
    s = X(2 -> 1, literal 3)
    wire w.out0 -- o.in0, w.out1 -- c1.in0, w.out2 -- c2.in0
    wire o.out0 -- p.in0, c1.out0 -- p.in1, c2.out0 -- p.in2
    wire c1.out1 -- m1.in0, m1.out0 -- q1.in0, m1.out1 -- q1.in1, c2.out1 -- m2.in0, m2.out0 -- q2.in0
    wire q1.out0 -- s.in0, q2.out0 -- s.in1
    inputs w.in0
    outputs p.out0, s.out0
    scalar 3 * 3^(1/2) * 3^(1/2)

load @lhs
prove against @rhs
certificate kernel
