# [P2] Lemma A.76 (k = 2, j = 2, m = 4, m_1 = m_2 = 2): a W node of dimension m, outputs through the
# boxes x and y and splitters, the m_1 outputs into a W transpose and the m_2 outputs into another,
# is the box x + y into the splitter.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.
# A mixed-dimensional Z box is its definition ([P2] (2.3.3)): a Z box over the product of its leg
# dimensions, each leg through a binder or splitter whose other leg carries a pink dot.

@lhs =
    w1 = W(1 -> 2, literal 4)
    z2 = Z(1 -> 1, literal 4) weight{1: 0, 2: 0, 3: x}
    s3 = S(literal 2, literal 2)
    z4 = Z(1 -> 1, literal 4) weight{1: 0, 2: 0, 3: y}
    s5 = S(literal 2, literal 2)
    w6 = W(1 -> 2, literal 2)
    w7 = W(1 -> 2, literal 2)
    z8 = Z(1 -> 1, literal 2)
    z9 = Z(1 -> 1, literal 2)
    wire w1.out0 -- z2.in0, z2.out0 -- s3.in0, w1.out1 -- z4.in0, z4.out0 -- s5.in0, s3.out0 -- w6.out0, s5.out0 -- w6.out1, s3.out1 -- w7.out0, s5.out1 -- w7.out1, w6.in0 -- z8.in0, w7.in0 -- z9.in0
    inputs w1.in0
    outputs z8.out0, z9.out0

@rhs =
    z1 = Z(1 -> 1, literal 4) weight{1: 0, 2: 0, 3: x + y}
    s2 = S(literal 2, literal 2)
    wire z1.out0 -- s2.in0
    inputs z1.in0
    outputs s2.out0, s2.out1

load @lhs
prove against @rhs
certificate kernel
