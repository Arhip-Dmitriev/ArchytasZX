# [P2] Lemma A.61, second equality (m = 2, n = 3): the box 1 state into the splitter with the box a
# on its m output is the box a state into the splitter.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.
# A mixed-dimensional Z box is its definition ([P2] (2.3.3)): a Z box over the product of its leg
# dimensions, each leg through a binder or splitter whose other leg carries a pink dot.

@lhs =
    z1 = Z(0 -> 1, literal 6) weight{1: 0, 2: 0, 3: 0, 4: 0, 5: 1}
    s2 = S(literal 2, literal 3)
    z3 = Z(1 -> 1, literal 2) weight{1: a}
    wire z1.out0 -- s2.in0, s2.out0 -- z3.in0
    outputs z3.out0, s2.out1

@rhs =
    z1 = Z(0 -> 1, literal 6) weight{1: 0, 2: 0, 3: 0, 4: 0, 5: a}
    s2 = S(literal 2, literal 3)
    wire z1.out0 -- s2.in0
    outputs s2.out0, s2.out1

load @lhs
prove against @rhs
certificate kernel
