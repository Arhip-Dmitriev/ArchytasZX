# [P2] Lemma A.56 (m = 2, n = 3, k = 4 = s_k n + t_k), all wires of dimension mn: the box 1 state
# into a pink dot (1 -> 2); left: upward n, 1_m, -n s_k, upward n, 1_m, n; right: 1_n, -m t_k,
# upward m, 1_n; both into a pink dot (2 -> 1); is the box 1 state through the multiplier -k.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.
# A mixed-dimensional Z box is its definition ([P2] (2.3.3)): a Z box over the product of its leg
# dimensions, each leg through a binder or splitter whose other leg carries a pink dot.

@lhs =
    z1 = Z(0 -> 1, literal 6) weight{1: 0, 2: 0, 3: 0, 4: 0, 5: 1}
    x2 = X(1 -> 2, literal 6)
    x3 = X(1 -> 3, literal 6)
    z4 = Z(3 -> 1, literal 6)
    z5 = Z(1 -> 1, literal 6) weight{2: 0, 3: 0, 4: 0, 5: 0}
    z6 = Z(1 -> 3, literal 6)
    x7 = X(3 -> 1, literal 6)
    x8 = X(1 -> 3, literal 6)
    z9 = Z(3 -> 1, literal 6)
    z10 = Z(1 -> 1, literal 6) weight{2: 0, 3: 0, 4: 0, 5: 0}
    z11 = Z(1 -> 3, literal 6)
    x12 = X(3 -> 1, literal 6)
    z13 = Z(1 -> 1, literal 6) weight{3: 0, 4: 0, 5: 0}
    z14 = Z(1 -> 4, literal 6)
    x15 = X(4 -> 1, literal 6)
    x16 = X(1 -> 2, literal 6)
    z17 = Z(2 -> 1, literal 6)
    z18 = Z(1 -> 1, literal 6) weight{3: 0, 4: 0, 5: 0}
    x19 = X(2 -> 1, literal 6)
    wire z1.out0 -- x2.in0, x3.out0 -- z4.in0, x3.out1 -- z4.in1, x3.out2 -- z4.in2, z6.out0 -- x7.in0, z6.out1 -- x7.in1, z6.out2 -- x7.in2, x8.out0 -- z9.in0, x8.out1 -- z9.in1, x8.out2 -- z9.in2, z11.out0 -- x12.in0, z11.out1 -- x12.in1, z11.out2 -- x12.in2, z4.out0 -- z5.in0, z5.out0 -- z6.in0, x7.out0 -- x8.in0, z9.out0 -- z10.in0, z10.out0 -- z11.in0, z14.out0 -- x15.in0, z14.out1 -- x15.in1, z14.out2 -- x15.in2, z14.out3 -- x15.in3, x16.out0 -- z17.in0, x16.out1 -- z17.in1, z13.out0 -- z14.in0, x15.out0 -- x16.in0, z17.out0 -- z18.in0, x2.out0 -- x3.in0, x2.out1 -- z13.in0, x12.out0 -- x19.in0, z18.out0 -- x19.in1
    outputs x19.out0
    scalar 6^(1/2) * 6^(2/2) * 6^(2/2) * 6^(2/2) * 6^(2/2) * 6^(3/2) * 6^(1/2) * 6^(1/2)

@rhs =
    z1 = Z(0 -> 1, literal 6) weight{1: 0, 2: 0, 3: 0, 4: 0, 5: 1}
    z2 = Z(1 -> 2, literal 6)
    x3 = X(2 -> 1, literal 6)
    wire z2.out0 -- x3.in0, z2.out1 -- x3.in1, z1.out0 -- z2.in0
    outputs x3.out0
    scalar 6^(1/2)

load @lhs
prove against @rhs
certificate kernel
