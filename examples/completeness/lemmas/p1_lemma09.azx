# [P1] Lemma 9 (d = 3): the box 0 with no legs is the empty diagram.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.

@lhs =
    b = Z(0 -> 0, literal 3) weight[literal 3]{1: 0, 2: 0}

@rhs =
    scalar 1

load @lhs
prove against @rhs
certificate kernel
