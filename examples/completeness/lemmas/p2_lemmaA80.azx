# [P2] Lemma A.80 (d = 2, two outputs): the pink K_1 state into a W node of dimension d, each output
# into a plain green dot (1 -> 2), is the pink K_1 state of dimension d^2 into a W node, each output
# into a splitter d^2 -> (d, d).
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.
# A mixed-dimensional Z box is its definition ([P2] (2.3.3)): a Z box over the product of its leg
# dimensions, each leg through a binder or splitter whose other leg carries a pink dot.

@lhs =
    x1 = X(0 -> 1, literal 2) phase{k: 1*k/2}
    w2 = W(1 -> 2, literal 2)
    z3 = Z(1 -> 2, literal 2)
    z4 = Z(1 -> 2, literal 2)
    wire x1.out0 -- w2.in0, w2.out0 -- z3.in0, w2.out1 -- z4.in0
    outputs z3.out0, z3.out1, z4.out0, z4.out1
    scalar 2^(-1/2)

@rhs =
    x1 = X(0 -> 1, literal 4) phase{k: 1*k/4}
    w2 = W(1 -> 2, literal 4)
    s3 = S(literal 2, literal 2)
    s4 = S(literal 2, literal 2)
    wire x1.out0 -- w2.in0, w2.out0 -- s3.in0, w2.out1 -- s4.in0
    outputs s3.out0, s3.out1, s4.out0, s4.out1
    scalar 4^(-1/2)

load @lhs
prove against @rhs
certificate kernel
