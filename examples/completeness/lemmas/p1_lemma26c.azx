# [P1] Lemma 26 (d = 3, a = (a1, a2)): the Z box a on the left leg of a pink cup (2 -> 0) is the
# Z box <-a = (a2, a1) on its right leg.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.

@lhs =
    b = Z(1 -> 1, literal 3) weight{1: a1, 2: a2}; p = X(2 -> 0, literal 3); b -> p
    inputs b.in0, p.in1

@rhs =
    b = Z(1 -> 1, literal 3) weight{1: a2, 2: a1}; p = X(2 -> 0, literal 3); wire b.out0 -- p.in1
    inputs p.in0, b.in0

load @lhs
prove against @rhs
certificate kernel
