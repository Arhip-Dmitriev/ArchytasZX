# [P2] Lemma A.50 (m = 2, n = 3): the pink state of dimension mn into the splitter is the pink
# states of dimensions m and n.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.
# A mixed-dimensional Z box is its definition ([P2] (2.3.3)): a Z box over the product of its leg
# dimensions, each leg through a binder or splitter whose other leg carries a pink dot.

@lhs =
    x1 = X(0 -> 1, literal 6)
    s2 = S(literal 2, literal 3)
    wire x1.out0 -- s2.in0
    outputs s2.out0, s2.out1
    scalar 6^(-1/2)

@rhs =
    x1 = X(0 -> 1, literal 2)
    x2 = X(0 -> 1, literal 3)
    outputs x1.out0, x2.out0
    scalar 2^(-1/2) * 3^(-1/2)

load @lhs
prove against @rhs
certificate kernel
