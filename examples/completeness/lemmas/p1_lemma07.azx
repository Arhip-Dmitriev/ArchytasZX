# [P1] Lemma 7 (j = 1, d = 3): the pink K_1 state into the Z box effect a is the box (0, a_2 -
# 1).
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.

@lhs =
    p = X(0 -> 1, literal 3) phase{k: k/3}; z = Z(1 -> 0, literal 3) weight{1: a1, 2: a2}; p -> z
    scalar 3^(-1/2)

@rhs =
    b = Z(0 -> 0, literal 3) weight[literal 3]{1: 0, 2: a2 - 1}

load @lhs
prove against @rhs
certificate kernel
