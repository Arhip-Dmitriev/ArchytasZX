# [P2] Lemma A.72 (m = 2, n = 3): two box 1s of dimension mn, each into a splitter with a plain green
# effect on its n output, the m outputs into a plain green dot (2 -> 1), is the box 1 (2 -> 1) into
# a splitter with a plain green effect on its n output.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.
# A mixed-dimensional Z box is its definition ([P2] (2.3.3)): a Z box over the product of its leg
# dimensions, each leg through a binder or splitter whose other leg carries a pink dot.

@lhs =
    z1 = Z(1 -> 1, literal 6) weight{1: 0, 2: 0, 3: 0, 4: 0, 5: 1}
    s2 = S(literal 2, literal 3)
    z3 = Z(1 -> 1, literal 6) weight{1: 0, 2: 0, 3: 0, 4: 0, 5: 1}
    s4 = S(literal 2, literal 3)
    z5 = Z(1 -> 0, literal 3)
    z6 = Z(1 -> 0, literal 3)
    z7 = Z(2 -> 1, literal 2)
    wire z1.out0 -- s2.in0, z3.out0 -- s4.in0, s2.out1 -- z5.in0, s4.out1 -- z6.in0, s2.out0 -- z7.in0, s4.out0 -- z7.in1
    inputs z1.in0, z3.in0
    outputs z7.out0

@rhs =
    z1 = Z(2 -> 1, literal 6) weight{1: 0, 2: 0, 3: 0, 4: 0, 5: 1}
    s2 = S(literal 2, literal 3)
    z3 = Z(1 -> 0, literal 3)
    wire z1.out0 -- s2.in0, s2.out1 -- z3.in0
    inputs z1.in0, z1.in1
    outputs s2.out0

load @lhs
prove against @rhs
certificate kernel
