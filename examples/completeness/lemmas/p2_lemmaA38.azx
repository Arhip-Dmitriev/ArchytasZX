    wire x6.out0 -- b5.in0, b5.out0 -- z4.in0, x8.out0 -- b7.in0, b7.out0 -- z4.in1, x10.out0 -- b9.in0, b9.out0 -- z4.in2, z4.out0 -- s11.in0, s11.out0 -- x12.in0, w1.out0 -- b5.in1, x2.out0 -- b7.in1, x3.out0 -- b9.in1, x15.out0 -- b14.in0, b14.out0 -- z13.in0, x17.out0 -- b16.in0, b16.out0 -- z13.in1, x19.out0 -- b18.in0, b18.out0 -- z13.in2, z13.out0 -- s20.in0, s20.out0 -- x21.in0, w1.out1 -- b14.in1, x2.out1 -- b16.in1, x3.out1 -- b18.in1
