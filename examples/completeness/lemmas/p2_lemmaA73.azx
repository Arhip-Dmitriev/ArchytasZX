# [P2] Lemma A.73 (m = 2, n = 3): two box 1s of dimension mn into a W transpose, then the splitter, are
# a splitter after each box, the m outputs into a W transpose and the n outputs into another.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.
# A mixed-dimensional Z box is its definition ([P2] (2.3.3)): a Z box over the product of its leg
# dimensions, each leg through a binder or splitter whose other leg carries a pink dot.

@lhs =
    z1 = Z(1 -> 1, literal 6) weight{1: 0, 2: 0, 3: 0, 4: 0, 5: 1}
    z2 = Z(1 -> 1, literal 6) weight{1: 0, 2: 0, 3: 0, 4: 0, 5: 1}
    w3 = W(1 -> 2, literal 6)
    s4 = S(literal 2, literal 3)
    wire z1.out0 -- w3.out0, z2.out0 -- w3.out1, w3.in0 -- s4.in0
    inputs z1.in0, z2.in0
    outputs s4.out0, s4.out1

@rhs =
    z1 = Z(1 -> 1, literal 6) weight{1: 0, 2: 0, 3: 0, 4: 0, 5: 1}
    z2 = Z(1 -> 1, literal 6) weight{1: 0, 2: 0, 3: 0, 4: 0, 5: 1}
    s3 = S(literal 2, literal 3)
    s4 = S(literal 2, literal 3)
    w5 = W(1 -> 2, literal 2)
    w6 = W(1 -> 2, literal 3)
    z7 = Z(1 -> 1, literal 2)
    z8 = Z(1 -> 1, literal 3)
    wire z1.out0 -- s3.in0, z2.out0 -- s4.in0, s3.out0 -- w5.out0, s4.out0 -- w5.out1, s3.out1 -- w6.out0, s4.out1 -- w6.out1, w5.in0 -- z7.in0, w6.in0 -- z8.in0
    inputs z1.in0, z2.in0
    outputs z7.out0, z8.out0

load @lhs
prove against @rhs
certificate kernel
