# [P2] Lemma A.35, (Pcy) (m = 2, n = 3): the Z box a (m -> n) into a W node of dimension n is a W
# node of dimension m with the Z box a on each output.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.
# A mixed-dimensional Z box is its definition ([P2] (2.3.3)): a Z box over the product of its leg
# dimensions, each leg through a binder or splitter whose other leg carries a pink dot.

@lhs =
    z1 = Z(1 -> 1, literal 6) weight{1: a1, 2: 0, 3: 0, 4: 0, 5: 0}
    b2 = B(literal 3, literal 2)
    x3 = X(0 -> 1, literal 3)
    s4 = S(literal 2, literal 3)
    x5 = X(1 -> 0, literal 2)
    w6 = W(1 -> 2, literal 3)
    wire x3.out0 -- b2.in0, b2.out0 -- z1.in0, z1.out0 -- s4.in0, s4.out0 -- x5.in0, s4.out1 -- w6.in0
    inputs b2.in1
    outputs w6.out0, w6.out1
    scalar 3^(-1/2) * 2^(-1/2)

@rhs =
    w1 = W(1 -> 2, literal 2)
    z2 = Z(1 -> 1, literal 6) weight{1: a1, 2: 0, 3: 0, 4: 0, 5: 0}
    b3 = B(literal 3, literal 2)
    x4 = X(0 -> 1, literal 3)
    s5 = S(literal 2, literal 3)
    x6 = X(1 -> 0, literal 2)
    z7 = Z(1 -> 1, literal 6) weight{1: a1, 2: 0, 3: 0, 4: 0, 5: 0}
    b8 = B(literal 3, literal 2)
    x9 = X(0 -> 1, literal 3)
    s10 = S(literal 2, literal 3)
    x11 = X(1 -> 0, literal 2)
    wire x4.out0 -- b3.in0, b3.out0 -- z2.in0, z2.out0 -- s5.in0, s5.out0 -- x6.in0, w1.out0 -- b3.in1, x9.out0 -- b8.in0, b8.out0 -- z7.in0, z7.out0 -- s10.in0, s10.out0 -- x11.in0, w1.out1 -- b8.in1
    inputs w1.in0
    outputs s5.out1, s10.out1
    scalar 3^(-1/2) * 2^(-1/2) * 3^(-1/2) * 2^(-1/2)

load @lhs
prove against @rhs
certificate kernel
