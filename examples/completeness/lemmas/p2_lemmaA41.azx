# [P2] Lemma A.41 (m = 3, n = 2, k = 2): the plain green dot (mn -> m), the upward multiplier k and the
# plain green dot (m -> mn) are the box 1_m, the multiplier n, the upward multiplier kn and 1_m.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.
# A mixed-dimensional Z box is its definition ([P2] (2.3.3)): a Z box over the product of its leg
# dimensions, each leg through a binder or splitter whose other leg carries a pink dot.

@lhs =
    z1 = Z(1 -> 1, literal 18) weight{3: 0, 4: 0, 5: 0, 6: 0, 7: 0, 8: 0, 9: 0, 10: 0, 11: 0, 12: 0, 13: 0, 14: 0, 15: 0, 16: 0, 17: 0}
    b2 = B(literal 3, literal 6)
    x3 = X(0 -> 1, literal 3)
    s4 = S(literal 6, literal 3)
    x5 = X(1 -> 0, literal 6)
    x6 = X(1 -> 2, literal 3)
    z7 = Z(2 -> 1, literal 3)
    z8 = Z(1 -> 1, literal 18) weight{3: 0, 4: 0, 5: 0, 6: 0, 7: 0, 8: 0, 9: 0, 10: 0, 11: 0, 12: 0, 13: 0, 14: 0, 15: 0, 16: 0, 17: 0}
    b9 = B(literal 6, literal 3)
    x10 = X(0 -> 1, literal 6)
    s11 = S(literal 3, literal 6)
    x12 = X(1 -> 0, literal 3)
    wire x3.out0 -- b2.in0, b2.out0 -- z1.in0, z1.out0 -- s4.in0, s4.out0 -- x5.in0, x6.out0 -- z7.in0, x6.out1 -- z7.in1, x10.out0 -- b9.in0, b9.out0 -- z8.in0, z8.out0 -- s11.in0, s11.out0 -- x12.in0, s4.out1 -- x6.in0, z7.out0 -- b9.in1
    inputs b2.in1
    outputs s11.out1
    scalar 3^(-1/2) * 6^(-1/2) * 3^(1/2) * 6^(-1/2) * 3^(-1/2)

@rhs =
    z1 = Z(1 -> 1, literal 6) weight{3: 0, 4: 0, 5: 0}
    z2 = Z(1 -> 2, literal 6)
    x3 = X(2 -> 1, literal 6)
    x4 = X(1 -> 4, literal 6)
    z5 = Z(4 -> 1, literal 6)
    z6 = Z(1 -> 1, literal 6) weight{3: 0, 4: 0, 5: 0}
    wire z2.out0 -- x3.in0, z2.out1 -- x3.in1, x4.out0 -- z5.in0, x4.out1 -- z5.in1, x4.out2 -- z5.in2, x4.out3 -- z5.in3, z1.out0 -- z2.in0, x3.out0 -- x4.in0, z5.out0 -- z6.in0
    inputs z1.in0
    outputs z6.out0
    scalar 6^(1/2) * 6^(3/2)

load @lhs
prove against @rhs
certificate kernel
