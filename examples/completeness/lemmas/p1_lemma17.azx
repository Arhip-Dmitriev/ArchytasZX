# [P1] Lemma 17 (d = 3): D on a plain green state is the plain green state.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.

@lhs =
    z = Z(0 -> 1, literal 3); z -> F(literal 3) -> F(literal 3)

@rhs =
    z = Z(0 -> 1, literal 3)

load @lhs
prove against @rhs
certificate kernel
