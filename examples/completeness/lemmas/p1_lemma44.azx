# [P1] Lemma 44 (j = 1, two wires, d = 3): the pink K_j state into a W node (1 -> 2) whose outputs
# meet plain green dots on two wires is the green dots fed upwards into a W transpose bent up to the
# pink K_j spider with one output leg.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.

@lhs =
    p = X(0 -> 1, literal 3) phase{k: k/3}; w = W(1 -> 2, literal 3); g1 = Z(2 -> 1, literal 3); g2 = Z(2 -> 1, literal 3)
    wire p.out0 -- w.in0, w.out0 -- g1.in1, w.out1 -- g2.in1
    inputs g1.in0, g2.in0
    outputs g1.out0, g2.out0
    scalar 3^(-1/2)

@rhs =
    g1 = Z(1 -> 2, literal 3); g2 = Z(1 -> 2, literal 3); w = W(1 -> 2, literal 3); p = X(0 -> 1, literal 3) phase{k: k/3}
    wire g1.out1 -- w.out0, g2.out1 -- w.out1, w.in0 -- p.out0
    inputs g1.in0, g2.in0
    outputs g1.out0, g2.out0
    scalar 3^(-1/2)

load @lhs
prove against @rhs
certificate kernel
