# [P2] Lemma A.25 (d = 3): a W node (1 -> 2) with D on both outputs is D followed by the W node.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.

@lhs =
    w = W(1 -> 2, literal 3); w -> F(literal 3) -> F(literal 3); w -> F(literal 3) -> F(literal 3)

@rhs =
    h = F(literal 3); w = W(1 -> 2, literal 3); h -> F(literal 3) -> w

load @lhs
prove against @rhs
certificate kernel
