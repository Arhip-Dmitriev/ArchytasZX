# [P1] Lemma 21 (d = 3): D on both legs of a plain green cap (a state) is the cap.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.

@lhs =
    g = Z(0 -> 2, literal 3); g -> F(literal 3) -> F(literal 3); g -> F(literal 3) -> F(literal 3)

@rhs =
    g = Z(0 -> 2, literal 3)

load @lhs
prove against @rhs
certificate kernel
