# [P1] Lemma 39 (m = 2, d = 3): a W node and a pink dot crossed into plain green dots are a
# plain green dot into a W node.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.

@lhs =
    w = W(1 -> 2, literal 3); p = X(1 -> 2, literal 3); g1 = Z(2 -> 1, literal 3); g2 = Z(2 -> 1, literal 3)
    wire w.out0 -- g1.in0, w.out1 -- g2.in0, p.out0 -- g1.in1, p.out1 -- g2.in1
    inputs w.in0, p.in0
    outputs g1.out0, g2.out0
    scalar 3^(1/2)

@rhs =
    g = Z(2 -> 1, literal 3); w = W(1 -> 2, literal 3); g -> w

load @lhs
prove against @rhs
certificate kernel
