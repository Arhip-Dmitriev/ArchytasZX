# [P2] Lemma A.22 (d = 3, one output): the Z box a state is its normal form: the pink K_1 state into
# a W node (1 -> d), outputs through the boxes 1, a_1, a_2 and the multipliers -0, -1, -2 into a
# pink dot.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.
# A mixed-dimensional Z box is its definition ([P2] (2.3.3)): a Z box over the product of its leg
# dimensions, each leg through a binder or splitter whose other leg carries a pink dot.

@lhs =
    z1 = Z(0 -> 1, literal 3) weight{1: a1, 2: a2}
    outputs z1.out0

@rhs =
    x1 = X(0 -> 1, literal 3) phase{k: 1*k/3}
    w2 = W(1 -> 3, literal 3)
    x3 = X(3 -> 1, literal 3)
    z4 = Z(1 -> 1, literal 3) weight{1: 0, 2: 1}
    z5 = Z(1 -> 0, literal 3)
    x6 = X(0 -> 1, literal 3)
    z7 = Z(1 -> 1, literal 3) weight{1: 0, 2: a1}
    z8 = Z(1 -> 2, literal 3)
    x9 = X(2 -> 1, literal 3)
    z10 = Z(1 -> 1, literal 3) weight{1: 0, 2: a2}
    z11 = Z(1 -> 1, literal 3)
    x12 = X(1 -> 1, literal 3)
    wire x1.out0 -- w2.in0, w2.out0 -- z4.in0, z4.out0 -- z5.in0, x6.out0 -- x3.in0, z8.out0 -- x9.in0, z8.out1 -- x9.in1, w2.out1 -- z7.in0, z7.out0 -- z8.in0, x9.out0 -- x3.in1, z11.out0 -- x12.in0, w2.out2 -- z10.in0, z10.out0 -- z11.in0, x12.out0 -- x3.in2
    outputs x3.out0
    scalar 3^(-1/2) * 3^(2/2) * 3^(-1/2) * 3^(1/2)

load @lhs
prove against @rhs
certificate kernel
