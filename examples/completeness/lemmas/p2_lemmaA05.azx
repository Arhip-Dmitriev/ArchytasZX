# [P2] Lemma A.5 (d = 3): the plain green dot on a wire is the wire, between two Fourier boxes.
# Dimensions are literal.

@lhs =
    a = F(literal 3); g = Z(1 -> 1, literal 3); b = F(literal 3); a -> g -> b

@rhs =
    a = F(literal 3); b = F(literal 3); a -> b

load @lhs
prove against @rhs
certificate kernel
