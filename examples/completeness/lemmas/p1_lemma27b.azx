# [P1] Lemma 27 (d = 3): a pink state into a plain green dot (2 -> 1) is a pink effect beside a
# pink state.
# Dimensions are literal. Paper pink spiders are X spiders with their normalisation d^((m+n)/2 - 1) as scalar.

@lhs =
    p = X(0 -> 1, literal 3); g = Z(2 -> 1, literal 3); wire p.out0 -- g.in0
    inputs g.in1
    scalar 3^(-1/2)

@rhs =
    e = X(1 -> 0, literal 3); s = X(0 -> 1, literal 3)
    scalar 3^(-1/2) * 3^(-1/2)

load @lhs
prove against @rhs
certificate kernel
