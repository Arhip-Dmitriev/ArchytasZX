# Shor's: factor N via the period r of a^x mod N.

var N, a            #a is the pick with gcd(a, N) = 1 that in real life is non-trivial to find
var m = bitlen(N)
var n = 2*m
var Q = 2^n

gate U_f = |x>|y> -> |x>|y xor powmod(a, x, N)>
gate IQFT = |x> -> 1/sqrt(Q) sum(k in 0..Q){ e^(-2*pi*i*x*k/Q) |k> }

|psi> = |0>^@n @ |0>^@m
|psi> = (H^@n @ I) |psi>
|psi> = U_f |psi>
|psi> = (IQFT @ I) |psi>
show(|psi>)

var z = measure|psi> 
var r = denom(floor(z / 2^m) / Q, N)
var h = powmod(a, r/2, N)
var p = gcd(h - 1, N)
var q = N / p
show(r, p, q)
