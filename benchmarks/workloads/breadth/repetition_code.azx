# Repetition-code encoder then decoder for every n and d [nielsen2010quantum, section 10.1]:
# the data qudit copied into n ancillas |0> by CX (copy into X(2 -> 1), scale sqrt(d)), then
# CX^-1 (F^2 on the copied leg). Target (from the code's definition, decoding inverts
# encoding): the identity on the data qudit and |0>^n on the ancillas.
#   |0> = d^(-1/2) X(0 -> 1)

@rhs =
    count n
    z = Z(1 -> 1)
    repeat n: X(0 -> 1)
    scalar d^(-n/2)

load
    count n
    e = Z(1 -> 2)
    c = Z(1 -> 2)
    wire e.out0 -- c.in0
    repeat n: e.out1 -> t = X(2 -> 1), X(0 -> 1) -> t, t -> u = X(2 -> 1), c.out1 -> F -> F -> u
    inputs e.in0
    scalar d^(n/2)

decide against @rhs
