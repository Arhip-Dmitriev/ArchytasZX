# W node on |0> for every n and d [dur2000three; poor2023zxw]: the W node W(1 -> n) copies the
# basis state |0>. Target (from the W node's definition, W[0; 0, ..., 0] = 1): |0>^n.
#   |0> = d^(-1/2) X(0 -> 1)

@rhs =
    count n
    repeat n: X(0 -> 1)
    scalar d^(-n/2)

load
    count n
    X(0 -> 1) -> w = W(1 -> 1)
    repeat n: w.out0
    scalar d^(-1/2)

decide against @rhs
