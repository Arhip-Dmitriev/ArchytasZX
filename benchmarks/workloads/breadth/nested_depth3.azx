# Nested bang boxes, depth 3: the Fourier superposition on registers at every level, box
# k holding one register and box k + 1 (n, n m, n m p registers) [nielsen2010quantum, section 5.1].
# Target: the uniform state on every register.

@rhs =
    count n, m, p
    z0 = Z(0 -> 1)
    z1 = Z(0 -> 1)
    z2 = Z(0 -> 1)
    repeat n as A: z0, z1, z2
    repeat m as B in A: z1, z2
    repeat p as C in B: z2
    scalar d^(-(n + n*m + n*m*p)/2)

load
    count n, m, p
    x0 = X(0 -> 1) -> f0 = F
    x1 = X(0 -> 1) -> f1 = F
    x2 = X(0 -> 1) -> f2 = F
    repeat n as A: x0, f0, x1, f1, x2, f2
    repeat m as B in A: x1, f1, x2, f2
    repeat p as C in B: x2, f2
    scalar d^(-(n + n*m + n*m*p)/2)

decide against @rhs
