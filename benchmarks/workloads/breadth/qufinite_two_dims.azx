# States across wires of two symbolic dimensions d and e [wang2023qufinitezxw]: the Fourier
# superposition on each register. Target (from F's definition): the uniform state of each
# dimension, d^(-1/2) e^(-1/2) sum_{j<d, k<e} |j, k>.

@rhs =
    a = Z(0 -> 1, d)
    b = Z(0 -> 1, e)
    scalar d^(-1/2) * e^(-1/2)

load
    X(0 -> 1, d) -> F(d)
    X(0 -> 1, e) -> F(e)
    scalar d^(-1/2) * e^(-1/2)

decide against @rhs
