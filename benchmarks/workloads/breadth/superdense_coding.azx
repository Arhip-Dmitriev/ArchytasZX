# Qudit superdense coding [bennett1992communication], symbolic d, message (a, b) as counts:
# X^a Z^b on Alice's half of a Bell pair, then Bob's decoding CX^(-1) and F^(-1).
# Target (from the protocol): the basis state |b> on Alice's qudit and |a> on Bob's,
# |m> = d^(-1/2) X(0 -> 1) phase{k: -m k/d}.

@rhs =
    count a, b
    u = X(0 -> 1) phase{k: -b*k/d}
    v = X(0 -> 1) phase{k: -a*k/d}
    scalar d^(-1)

load
    count a, b
    s = Z(0 -> 2)
    p = X(1 -> 1) phase{k: a*k/d}
    q = Z(1 -> 1) phase{k: b*k/d}
    c = Z(1 -> 2)
    t = X(2 -> 1)
    f1 = F
    f2 = F
    wire s.out0 -- p.in0
    wire p.out0 -- q.in0
    wire q.out0 -- c.in0
    wire s.out1 -- t.in0
    wire c.out1 -- f1.in0
    wire f1.out0 -- f2.in0
    wire f2.out0 -- t.in1
    g = F
    h = F
    i = F
    wire c.out0 -- g.in0
    wire g.out0 -- h.in0
    wire h.out0 -- i.in0
    outputs i.out0, t.out0
    scalar d^(-1/2) * d^(1/2)

decide against @rhs
