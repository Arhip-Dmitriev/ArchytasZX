# The W state for every n [dur2000three; poor2023zxw]: W(1 -> n) on |1> is the sum of the n
# basis states with one 1. Target (from that definition): its overlap with the all-plus
# effect, sum_k <k| on every output, is n.
#   |1> = d^(-1/2) X(0 -> 1) phase{k: -k/d}
# Both sides carry the closed spider Z(0 -> 0) phase{1: 1/4} = d - 1 + i, which restricts the
# claim to d >= 2 (|1> needs d >= 2).

@rhs =
    count n
    f = Z(0 -> 0) phase{1: 1/4}
    scalar n

load
    count n
    X(0 -> 1) phase{k: -k/d} -> w = W(1 -> 1)
    repeat n: w.out0 -> Z(1 -> 0)
    f = Z(0 -> 0) phase{1: 1/4}
    scalar d^(-1/2)

decide against @rhs
