# Entanglement swapping [zukowski1993event], symbolic d: two Bell pairs, the Bell effect on
# their inner qudits. Target (from the protocol): a Bell pair on the outer qudits, scaled by
# the outcome amplitude 1/d.

@rhs =
    s = Z(0 -> 2)
    scalar d^(-3/2)

load
    s1 = Z(0 -> 2)
    s2 = Z(0 -> 2)
    e = Z(2 -> 0)
    wire s1.out1 -- e.in0
    wire s2.out0 -- e.in1
    outputs s1.out0, s2.out1
    scalar d^(-3/2)

decide against @rhs
