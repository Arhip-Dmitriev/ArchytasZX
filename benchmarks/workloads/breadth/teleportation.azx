# Qudit teleportation [bennett1993teleporting], symbolic d, Bell outcome (a, b) as counts.
# Target (from the protocol): the corrected output is the input, scaled by the outcome
# probability amplitude 1/d.
#
#   Bell pair   d^(-1/2) Z(0 -> 2)
#   Bell effect d^(-1/2) Z(2 -> 0) after X^a Z^b on the first leg
#   correction  Z^(-b) then X^(-a) on the output

@rhs =
    count a, b
    z = Z(1 -> 1)
    scalar d^(-1)

load
    count a, b
    s = Z(0 -> 2)
    p = X(1 -> 1) phase{k: a*k/d}
    q = Z(1 -> 1) phase{k: b*k/d}
    e = Z(2 -> 0)
    cz = Z(1 -> 1) phase{k: -b*k/d}
    cx = X(1 -> 1) phase{k: -a*k/d}
    wire p.out0 -- q.in0
    wire q.out0 -- e.in0
    wire s.out0 -- e.in1
    wire s.out1 -- cz.in0
    wire cz.out0 -- cx.in0
    inputs p.in0
    outputs cx.out0
    scalar d^(-1)

decide against @rhs
