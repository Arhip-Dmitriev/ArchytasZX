# Generalised Bernstein-Vazirani [bernstein1997complexity] for every n and d with the secret
# s = (s, ..., s), s a count: the oracle phase w^(s x_i) on each data qudit. Target (from the
# algorithm): |s>^n, |m> = d^(-1/2) X(0 -> 1) phase{k: -m k/d}.

@rhs =
    count n, s
    repeat n: X(0 -> 1) phase{k: -s*k/d}
    scalar d^(-n/2)

load
    count n, s
    repeat n: X(0 -> 1) -> F -> Z(1 -> 1) phase{k: s*k/d} -> F^3
    scalar d^(-n/2)

decide against @rhs
