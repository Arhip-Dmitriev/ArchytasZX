# Nested bang boxes, depth 1: the Fourier superposition on registers at every level, box
# k holding one register and box k + 1 (n registers) [nielsen2010quantum, section 5.1].
# Target: the uniform state on every register.

@rhs =
    count n
    z0 = Z(0 -> 1)
    repeat n as A: z0
    scalar d^(-(n)/2)

load
    count n
    x0 = X(0 -> 1) -> f0 = F
    repeat n as A: x0, f0
    scalar d^(-(n)/2)

decide against @rhs
